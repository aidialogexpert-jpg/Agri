    <!-- JavaScript -->
    <script>
        // Language Switching
        document.querySelectorAll('.lang-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.lang-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                alert('Language changed to ' + this.textContent);
                // You can add full translation functionality here
            });
        });

        // Admin Panel Functions
        function openAdminPanel() {
            document.getElementById('adminPanel').style.display = 'flex';
            loadAdminData();
        }

        function closeAdminPanel() {
            document.getElementById('adminPanel').style.display = 'none';
        }

        function loadAdminData() {
            // Load saved contact info
            const data = JSON.parse(localStorage.getItem('contactInfo') || '{}');
            document.getElementById('admin-email').value = data.email || 'contact@globalagritech.com';
            document.getElementById('admin-phone').value = data.phone || '+1 (555) 123-4567';
            document.getElementById('admin-address').value = data.address || '123 AgriTech Lane, Farmington, CA 90210, USA';
            document.getElementById('admin-support-email').value = data.supportEmail || 'support@globalagritech.com';
            document.getElementById('admin-support-hours').value = data.supportHours || '24/7 Support Available';
            
            // Load appointment submissions
            const submissions = JSON.parse(localStorage.getItem('appointments') || '[]');
            const list = document.getElementById('submissions-list');
            list.innerHTML = submissions.map((sub, i) => `
                <div style="padding: 10px; border-bottom: 1px solid #ddd; margin-bottom: 10px;">
                    <strong>${sub.name || 'No Name'}</strong> - ${sub.country || 'No Country'}<br>
                    <small>${sub.email || 'No Email'} | ${sub.phone || 'No Phone'}</small><br>
                    <small>${new Date(sub.timestamp).toLocaleString()}</small>
                </div>
            `).join('') || '<p>No submissions yet</p>';
        }

        // Save admin data
        document.getElementById('adminForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const data = {
                email: document.getElementById('admin-email').value,
                phone: document.getElementById('admin-phone').value,
                address: document.getElementById('admin-address').value,
                supportEmail: document.getElementById('admin-support-email').value,
                supportHours: document.getElementById('admin-support-hours').value
            };
            
            localStorage.setItem('contactInfo', JSON.stringify(data));
            
            // Update display on main page
            document.getElementById('contact-email').textContent = data.email;
            document.getElementById('contact-phone').textContent = data.phone;
            document.getElementById('contact-address').textContent = data.address;
            document.getElementById('support-email').textContent = data.supportEmail;
            document.getElementById('support-hours').textContent = data.supportHours;
            
            alert('Contact information updated successfully!');
            closeAdminPanel();
        });

        // Appointment Form Submission
        document.getElementById('appointmentForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const inputs = this.querySelectorAll('input, select, textarea');
            const formData = {};
            inputs.forEach(input => {
                if (input.name || input.type !== 'submit') {
                    formData[input.name || input.previousElementSibling?.textContent] = input.value;
                }
            });
            
            formData.timestamp = new Date().toISOString();
            
            // Save to localStorage
            let appointments = JSON.parse(localStorage.getItem('appointments') || '[]');
            appointments.push(formData);
            localStorage.setItem('appointments', JSON.stringify(appointments));
            
            alert('Appointment request submitted successfully! We will contact you within 24 hours.');
            this.reset();
            
            // Refresh admin panel if open
            if (document.getElementById('adminPanel').style.display === 'flex') {
                loadAdminData();
            }
        });

        // NowPayments Integration
        const nowpaymentsScript = document.createElement('script');
        nowpaymentsScript.src = 'https://nowpayments.io/embed/button.js';
        document.head.appendChild(nowpaymentsScript);
        
        window.nowpayments = window.nowpayments || {};
        nowpayments.settings = {
            api_key: "YOUR_NOWPAYMENTS_API_KEY", // Replace with your actual key
            amount: "150",
            currency: "usdt",
            order_id: "AGRI_" + Date.now(),
            order_description: "Agricultural IoT Consultation Package",
            success_url: window.location.origin + "/success",
            fail_url: window.location.origin + "/failed"
        };

        // Load saved contact info on page load
        document.addEventListener('DOMContentLoaded', function() {
            const savedData = JSON.parse(localStorage.getItem('contactInfo') || '{}');
            if (savedData.email) {
                document.getElementById('contact-email').textContent = savedData.email;
                document.getElementById('contact-phone').textContent = savedData.phone;
                document.getElementById('contact-address').textContent = savedData.address;
                document.getElementById('support-email').textContent = savedData.supportEmail;
                document.getElementById('support-hours').textContent = savedData.supportHours;
            }
        });

        // Smooth scrolling for navigation
        document.querySelectorAll('nav a').forEach(anchor => {
            anchor.addEventListener('click', function(e) {
                e.preventDefault();
                const targetId = this.getAttribute('href');
                const targetElement = document.querySelector(targetId);
                if (targetElement) {
                    window.scrollTo({
                        top: targetElement.offsetTop - 100,
                        behavior: 'smooth'
                    });
                }
            });
        });
    </script>
</body>
</html>
